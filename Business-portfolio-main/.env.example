# Copy to .env.local (local dev) and add the same variables in your hosting dashboard (e.g. Vercel → Settings → Environment Variables).

# --- Tawk.to live chat (optional: the IDs are already set in components/TawkChat.tsx; these override them) ---
# From Tawk.to → Administration → Channels → Chat Widget → Direct Chat Link: https://tawk.to/chat/<PROPERTY_ID>/<WIDGET_ID>
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=

# --- Booking form email delivery via Resend (server-only, keep secret) ---
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
# Optional: a sender on a domain you've verified in Resend, e.g. "FourBand Agency <hello@mail.fourbandagency.com>"
ENQUIRY_FROM_EMAIL=
